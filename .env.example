# GlycoRenal Twin settings. Copy this file to .env and fill in the blanks.
# .env is never committed to git.

# --- LLM, primary: Kimi (Moonshot AI). Copy base URL + model name from your Kimi dashboard.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# --- LLM, optional backup: Gemini (OpenAI-compatible endpoint)
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# --- Login tokens: a long random string (generate one, never share it)
JWT_SECRET=

# --- Hospital EHR (FHIR R4 test server)
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# --- Dexcom sandbox (optional; leave blank to hide the button)
DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=
DEXCOM_BASE_URL=https://sandbox-api.dexcom.com
DEXCOM_REDIRECT_URI=http://localhost:8000/devices/dexcom/callback

# --- Live sensor simulator: seconds between replayed 5-minute readings
SIM_SPEED_SECONDS=3

# --- Where the Streamlit UI finds the API
API_URL=http://localhost:8000
